    {"targets": ["Databricks"], "test": "DatabricksMetadataTests.ScopedDiscoveryFollowsReferencesAndReadsCanonicalDefinitions", "features": ["null-default", "current-timestamp"], "operation": "inspect", "expected": "supported"},
