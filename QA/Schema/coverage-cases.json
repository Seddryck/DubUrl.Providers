    {"targets": ["DuckDb"], "test": "TypedDefaultTests.CompatibilityUsersAndInsertSessionContextAreDiscovered", "features": ["current-schema", "current-database", "uuid-native"], "operation": "both", "expected": "supported"},
    {"targets": ["DuckDb"], "test": "TypedDefaultTests.QuotedExternalSequenceIsSharedAndSurvivesTableReplacement", "features": ["sequence-default"], "operation": "both", "expected": "limited", "note": "Schema-qualified sequence. Names containing an embedded double quote are rejected."},
    {"targets": ["Oracle"], "test": "TypedDefaultTests.DefaultsAreEvaluatedOnInsertAndRecognizedInTheCatalog", "features": ["current-date", "current-timestamp", "utc-timestamp", "current-user", "session-user", "current-schema", "current-database", "uuid-binary", "sequence-default"], "operation": "inspect", "expected": "limited", "note": "Requires the version-aware OracleMetadataReader and Oracle 23 or later."},
    {"targets": ["Oracle"], "test": "TypedDefaultTests.DefaultsAreEvaluatedOnInsertAndRecognizedInTheCatalog", "features": ["current-date", "current-timestamp", "utc-timestamp", "current-user", "session-user", "current-schema", "current-database", "uuid-binary", "sequence-default"], "operation": "generate", "expected": "supported"},
    {"targets": ["MySql"], "test": "TypedDefaultTests.ContextUsesInsertSessionAndUuidsUseExplicitRepresentation", "features": ["current-user", "session-user", "current-schema", "current-database", "uuid-text", "uuid-binary"], "operation": "both", "expected": "limited", "note": "Requires the version-qualified InnoDB dialect. Namespace defaults can be NULL in an unscoped session."},
    {"targets": ["Sqlite"], "test": "TypedDefaultTests.UuidTextPreservesVersionVariantAndExplicitInput", "features": ["uuid-text"], "operation": "both", "expected": "supported"},
