    {"targets": ["SqlServer", "SqlServer-2025"], "test": "TypedDefaultTests.EffectiveUserChangesWhileSessionIdentityAndUuidArePreserved", "features": ["current-user", "session-user", "current-schema", "current-database", "uuid-native"], "operation": "both", "expected": "supported"},
    {"targets": ["PostgreSql"], "test": "TypedDefaultTests.EffectiveUserChangesWhileSessionIdentityAndUuidArePreserved", "features": ["current-user", "session-user", "current-schema", "current-database"], "operation": "both", "expected": "supported"},
    {"targets": ["PostgreSql"], "test": "TypedDefaultTests.EffectiveUserChangesWhileSessionIdentityAndUuidArePreserved", "features": ["uuid-native"], "operation": "both", "expected": "limited", "note": "Generation requires a version-qualified PostgreSQL 13+ dialect."},
