<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ProviderSchemaDiagnostics>true</ProviderSchemaDiagnostics>
    <Description>DuckDB dialect, mapping, and rewriting for DubUrl.</Description>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Sql\Formatting\ReservedKeywords\*.txt"
                      LogicalName="DubUrl.Provider.DuckDb.Sql.Formatting.ReservedKeywords.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="DubUrl.Schema" Version="$(SchemaPackageVersion)" />
  </ItemGroup>
  <Import Project="..\..\Provider.Build.props" />
</Project>
