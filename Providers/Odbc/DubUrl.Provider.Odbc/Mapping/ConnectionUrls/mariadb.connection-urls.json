{
  "routes": [
    {
      "id": "maria-odbc",
      "api": "ODBC",
      "driver": "MariaDB Connector/ODBC",
      "scheme": "odbc+mariadb",
      "locations": [
        "requiredDatabase"
      ],
      "tls": "mariaOdbc",
      "fields": {
        "port": {
          "layout": "port",
          "default": 3306,
          "queryKey": "PORT"
        }
      },
      "auth": [
        "password",
        {
          "id": "integrated",
          "note": "Requires MariaDB ODBC 3.1/3.2 and the vendor GSSAPI plugin.",
          "fields": {
            "username": {
              "layout": "text",
              "label": "Username",
              "required": true,
              "url": "username"
            }
          }
        },
        {
          "id": "certificate",
          "note": "Requires 3.1.1+ and unencrypted PEM files."
        }
      ],
      "providerInvariant": "System.Data.Odbc"
    },
    {
      "id": "maria-mysql-odbc",
      "api": "ODBC",
      "driver": "MySQL Connector/ODBC against MariaDB",
      "scheme": "odbc+mariadb",
      "locations": [
        "requiredDatabase"
      ],
      "tls": "mysqlOdbc",
      "fields": {
        "port": {
          "layout": "port",
          "default": 3306,
          "queryKey": "PORT"
        },
        "installedDriver": {
          "layout": "text",
          "label": "Installed driver name",
          "queryKey": "Driver",
          "required": true
        }
      },
      "auth": [
        "password",
        {
          "id": "certificate",
          "note": "MySQL Connector/ODBC 8+ and unencrypted PEM files."
        }
      ],
      "providerInvariant": "System.Data.Odbc"
    }
  ],
  "tlsPolicies": {
    "mariaOdbc": {
      "modes": [
        {
          "id": "default",
          "label": "Driver default"
        },
        {
          "id": "verified",
          "label": "Require verified TLS",
          "via": "url",
          "query": {
            "FORCETLS": "1",
            "SSLVERIFY": "1"
          },
          "secure": true
        }
      ]
    }
  }
}
