<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <QaProvider>firebirdsql</QaProvider>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="FirebirdSql.Data.FirebirdClient" Version="10.3.3" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="NUnit" Version="5.0.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="5.1.0" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="DubUrl" Version="$(DubUrlVersion)" />
    <ProjectReference Include="..\..\..\QA\DubUrl.Provider.QA\DubUrl.Provider.QA.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="qa-manifest.json" CopyToOutputDirectory="PreserveNewest" />
    <QaInfrastructure Include="infrastructure\**\*" />
  </ItemGroup>
  <Import Project="..\..\..\build\ProviderQaBundle.targets" />
  <ItemGroup>
    <ProjectReference Include="../DubUrl.Provider.FirebirdSql/DubUrl.Provider.FirebirdSql.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="DubUrl.Provider.FirebirdSql.QA.infrastructure" />
    <Using Include="DubUrl.Provider.FirebirdSql.QA.Query" />
  </ItemGroup>
</Project>
