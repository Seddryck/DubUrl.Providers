  "sources": {
    "providerLists": "https://github.com/Seddryck/DubUrl/tree/ef1dc69f63fa1ee3f9a7fd39a0ce57737893ecc2/docs/_data",
    "providerMappings": "https://github.com/Seddryck/DubUrl.Providers/tree/57c67a7ba675752114f64b8c5f0b24839c6ba1ca/Providers",
    "authentication": "https://github.com/Seddryck/DubUrl/blob/ef1dc69f63fa1ee3f9a7fd39a0ce57737893ecc2/docs/_docs/authentication.md",
    "osIdentity": "https://github.com/Seddryck/DubUrl/blob/ef1dc69f63fa1ee3f9a7fd39a0ce57737893ecc2/docs/operating-system-identity-mappings.md",
    "clientCertificate": "https://github.com/Seddryck/DubUrl/blob/ef1dc69f63fa1ee3f9a7fd39a0ce57737893ecc2/docs/client-certificate-authentication.md",
    "tls": "https://github.com/Seddryck/DubUrl/blob/ef1dc69f63fa1ee3f9a7fd39a0ce57737893ecc2/docs/_docs/connection-configuration.md",
    "odbc": "https://github.com/Seddryck/DubUrl/blob/ef1dc69f63fa1ee3f9a7fd39a0ce57737893ecc2/docs/_docs/odbc-driver-locators.md",
    "databricks": "https://docs.databricks.com/aws/en/integrations/odbc/authentication",
    "npgsql": "https://www.npgsql.org/doc/connection-string-parameters",
    "trinoOdbc": "https://documentation.insightsoftware.com/trino-online-documentation-windows/content/odbc/tri/authentication/intro.htm",
    "sparkOdbc": "https://documentation.insightsoftware.com/simba-spark-windows-driver-guide/content/odbc/sp/strings.htm",
