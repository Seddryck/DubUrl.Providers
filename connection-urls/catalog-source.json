{
  "$schema": "./schema.json",
  "schemaVersion": 2,
  "scope": "Named DubUrl connection profiles. Authentication and TLS depend on the installed client driver and server configuration.",
  "layouts": {
    "text": {},
    "host": {
      "label": "Host",
      "placeholder": "db.example.com"
    },
    "port": {
      "label": "Port",
      "inputMode": "numeric"
    }
  },
  "driverFields": {
    "ODBC": {
      "installedDriver": {
        "layout": "text",
        "label": "Installed driver name",
        "queryKey": "Driver"
      }
    },
    "OLE DB": {
      "installedProvider": {
        "layout": "text",
        "label": "Installed provider name",
        "queryKey": "Provider"
      }
    }
  },
  "locations": {
    "requiredDatabase": {
      "transport": "TCP",
      "fields": {
        "host": {
          "layout": "host",
          "required": true,
          "url": "host"
        },
        "port": {
          "layout": "port",
          "url": "port"
        },
        "database": {
          "layout": "text",
          "label": "Database",
          "required": true
        }
      },
      "path": [
        "database"
      ]
    },
    "sqlServerWrapped": {
      "transport": "TCP",
      "fields": {
        "host": {
          "layout": "host",
          "required": true,
          "url": "host"
        },
        "port": {
          "layout": "port",
          "url": "port",
          "defaultUnless": [
            "instance"
          ],
          "placeholder": "1433 (default instance)"
        },
        "instance": {
          "layout": "text",
          "label": "Instance"
        },
        "database": {
          "layout": "text",
          "label": "Database",
          "required": true
        }
      },
      "path": [
        "instance",
        "database"
      ]
    },
    "server": {
      "transport": "TCP",
      "fields": {
        "host": {
          "layout": "host",
          "required": true,
          "url": "host"
        },
        "port": {
          "layout": "port",
          "url": "port"
        }
      }
    },
    "service": {
      "label": "Service on a server",
      "transport": "TCP",
      "fields": {
        "host": {
          "layout": "host",
          "required": true,
          "url": "host"
        },
        "port": {
          "layout": "port",
          "url": "port"
        },
        "service": {
          "layout": "text",
          "label": "Service name",
          "required": true
        }
      },
      "path": [
        "service"
      ]
    },
    "tns": {
      "label": "TNS alias",
      "transport": "Oracle Net",
      "fields": {
        "tnsAlias": {
          "layout": "text",
          "label": "TNS alias",
          "required": true,
          "url": "host"
        }
      }
    },
    "catalogSchema": {
      "transport": "HTTP",
      "requires": {
        "schema": "catalog"
      },
      "fields": {
        "host": {
          "layout": "host",
          "required": true,
          "url": "host"
        },
        "port": {
          "layout": "port",
          "url": "port"
        },
        "catalog": {
          "layout": "text",
          "label": "Catalog"
        },
        "schema": {
          "layout": "text",
          "label": "Schema"
        }
      },
      "path": [
        "catalog",
        "schema"
      ]
    },
    "thriftTcp": {
      "label": "TCP",
      "transport": "TCP",
      "fields": {
        "host": {
          "layout": "host",
          "required": true,
          "url": "host"
        },
        "port": {
          "layout": "port",
          "default": 10000,
          "url": "port"
        },
        "schema": {
          "layout": "text",
          "label": "Schema"
        }
      },
      "path": [
        {
          "literal": "schema",
          "when": "schema"
        },
        "schema"
      ]
    },
    "thriftHttp": {
      "label": "HTTP",
      "transport": "HTTP",
      "fields": {
        "host": {
          "layout": "host",
          "required": true,
          "url": "host"
        },
        "port": {
          "layout": "port",
          "default": 10001,
          "url": "port"
        },
        "httpPath": {
          "layout": "text",
          "label": "HTTP endpoint path",
          "default": "/cliservice"
        },
        "schema": {
          "layout": "text",
          "label": "Schema"
        }
      },
      "path": [
        {
          "split": "httpPath",
          "reserveSuffix": "schema"
        },
        {
          "literal": "schema",
          "when": "schema"
        },
        "schema"
      ]
    },
    "file": {
      "label": "Database file",
      "transport": "Local file",
      "fields": {
        "file": {
          "layout": "text",
          "label": "File path",
          "required": true,
          "placeholder": "C:/data/example.db"
        }
      },
      "path": [
        {
          "file": "file"
        }
      ]
    },
    "memory": {
      "label": "In memory",
      "transport": "In memory"
    }
  },
  "tlsPolicies": {
    "driverDefault": {
      "modes": [
        {
          "id": "default",
          "label": "Driver default"
        }
      ]
    },
    "fixed": {
      "modes": [
        {
          "id": "default",
          "label": "Required",
          "secure": true,
          "transport": "HTTPS"
        }
      ]
    },
    "nativeVerified": {
      "modes": [
        {
          "id": "default",
          "label": "Driver default"
        },
        {
          "id": "verified",
          "label": "Require verified TLS",
          "via": "runtime",
          "cli": [
            "--tls"
          ],
          "library": "WithEncryption(ConnectionEncryption.Tls())",
          "secure": true
        }
      ]
    },
    "npgsql": {
      "modes": [
        {
          "id": "default",
          "label": "Driver default"
        },
        {
          "id": "verified",
          "label": "Require verified TLS",
          "via": "url",
          "query": {
            "SSL Mode": "VerifyFull",
            "GSS Encryption Mode": "Disable"
          },
          "secure": true
        }
      ]
    },
    "mysql": {
      "modes": [
        {
          "id": "default",
          "label": "Driver default"
        },
        {
          "id": "verified",
          "label": "Require verified TLS",
          "via": "url",
          "query": {
            "SSL Mode": "VerifyFull"
          },
          "secure": true
        }
      ]
    },
    "mysqlOdbc": {
      "modes": [
        {
          "id": "default",
          "label": "Driver default"
        },
        {
          "id": "verified",
          "label": "Require verified TLS",
          "via": "url",
          "query": {
            "SSLMODE": "VERIFY_IDENTITY"
          },
          "secure": true
        }
      ]
    },
    "thrift": {
      "modes": [
        {
          "id": "default",
          "label": "Off"
        },
        {
          "id": "on",
          "label": "On",
          "via": "scheme",
          "secure": true,
          "transportByProtocol": {
            "HTTP": "HTTPS",
            "TCP": "TCP with TLS"
          }
        }
      ]
    }
  },
  "authentication": {
    "password": {
      "label": "Username and password",
      "via": "runtime",
      "cli": [
        "--password-prompt"
      ],
      "library": "ConnectionAuthentication.Password(…)",
      "fields": {
        "username": {
          "layout": "text",
          "label": "Username",
          "required": true,
          "url": "username"
        }
      }
    },
    "integrated": {
      "label": "Operating-system identity",
      "via": "runtime",
      "cli": [
        "--os-identity"
      ],
      "library": "ConnectionAuthentication.OperatingSystemIdentity()"
    },
    "certificate": {
      "label": "Client certificate",
      "via": "runtime",
      "requiresTls": true,
      "tlsOverride": "nativeVerified",
      "cli": [
        "--client-certificate",
        "client.crt",
        "--client-key",
        "client.key"
      ],
      "library": "ConnectionAuthentication.ClientCertificate(…)",
      "fields": {
        "username": {
          "layout": "text",
          "label": "Username",
          "required": true,
          "url": "username"
        }
      }
    },
    "browser": {
      "label": "OAuth browser sign-in",
      "via": "runtime",
      "cli": [
        "--oauth",
        "browser"
      ],
      "library": "Provider OAuth session + ConnectionAuthentication.OAuthInteractive(…)"
    },
    "driver": {
      "label": "Driver-managed sign-in",
      "via": "external",
      "note": "Configure the vendor's identity or connection properties in the consuming application."
    },
    "none": {
      "label": "No sign-in",
      "via": "url"
    },
    "userOnly": {
      "label": "Username only (unauthenticated server)",
      "via": "url",
      "fields": {
        "username": {
          "layout": "text",
          "label": "Username",
          "required": true,
          "url": "username"
        }
      }
    },
    "thriftNone": {
      "label": "No sign-in",
      "via": "url",
      "query": {
        "AuthMech": "0"
      }
    },
    "thriftPassword": {
      "label": "Username and password",
      "via": "runtime",
      "query": {
        "AuthMech": "3"
      },
      "cli": [
        "--password-prompt"
      ],
      "library": "ConnectionAuthentication.Password(…)",
      "fields": {
        "username": {
          "layout": "text",
          "label": "Username",
          "required": true,
          "url": "username"
        }
      }
    },
    "thriftKerberos": {
      "label": "Kerberos (vendor driver)",
      "via": "external",
      "query": {
        "AuthMech": "1"
      },
      "note": "Set the service principal and other Kerberos properties required by your driver."
    },
    "thriftUsername": {
      "label": "Username only",
      "via": "url",
      "fields": {
        "username": {
          "layout": "text",
          "label": "Username",
          "required": true,
          "url": "username"
        }
      }
    }
  },
  "databases": [
